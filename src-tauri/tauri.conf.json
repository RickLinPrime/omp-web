{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omp-desktop",
  "version": "0.2.14",
  "identifier": "com.ricklinprime.omp-desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:30141",
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "omp-desktop",
        "width": 1280,
        "height": 800,
        "url": "index.html"
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "./server/node_modules": "node_modules",
      "./server/.next": ".next",
      "./server/bin": "bin",
      "./server/public": "public",
      "./server/next.config.ts": "next.config.ts",
      "./server/package.json": "package.json"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1QTY1MTZBREEyREVFRUQKUldUdDdpM2FhbEdteGRLeXV2R21aS2VqMlF3U0prV0huT3lObERodStPd1NEQmJFV1I5a1ZUbXQK",
      "endpoints": [
        "https://github.com/RickLinPrime/omp-web/releases/latest/download/latest.json"
      ]
    }
  }
}
